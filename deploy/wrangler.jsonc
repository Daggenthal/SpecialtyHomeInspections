// Cloudflare Workers static site (no server code, just files).
// The editor's "Publish to website" runs wrangler deploy with this file.
//
// The real address is attached automatically on publish, once the editor's Website setup
// shows the domain is on Cloudflare and email forwarding is on (so John@ keeps working).
// Until then the site lives on its temporary *.workers.dev address.
{
  "name": "specialty-home-inspections",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "../dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true
}
