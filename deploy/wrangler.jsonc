// Cloudflare Workers static site (no server code, just files).
// The editor's "Publish to website" runs:  npx wrangler@4 deploy --config deploy/wrangler.jsonc
{
  "name": "specialty-home-inspections",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "../dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true

  // Once the domain's nameservers point to Cloudflare, uncomment this so the
  // site answers on the real address (Cloudflare creates the DNS records):
  // ,"routes": [
  //   { "pattern": "specialtyhomeinspections.biz", "custom_domain": true },
  //   { "pattern": "www.specialtyhomeinspections.biz", "custom_domain": true }
  // ]
}
